{
  "manifest_version": 3,
  "name": "Command Center Bridge",
  "version": "0.4.0",
  "description": "Local-only bridge between claude.ai (Cowork) / chatgpt.com sessions and the Command Center on this computer.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "protocol.js",
        "selectors.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "protocol.js",
        "chatgpt-selectors.js",
        "chatgpt-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
